# ===== 애플리케이션 =====
# Caddy 가 외부에 여는 포트. 프론트는 HTTPS(443)로 요청하고, 80 은 HTTPS 로 리다이렉트된다
APP_PORT=80
APP_HTTPS_PORT=443
# 서비스 주소. 도메인을 넣으면 Caddy 가 Let's Encrypt 인증서를 자동 발급한다.
# IP 를 넣으면 공인 인증서를 받을 수 없어 Caddy 내장 CA(자체 서명)로 HTTPS 를 제공한다.
SITE_ADDRESS=CHANGE_ME
# 블루그린 컨테이너가 번갈아 쓰는 포트 (루프백 바인딩, 외부 비공개)
APP_BLUE_PORT=8081
APP_GREEN_PORT=8082

# ===== MySQL =====
MYSQL_PORT=3306
MYSQL_DATABASE=dearjolly
MYSQL_USER=jolly
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ===== JPA =====
# 스키마는 Flyway 가 소유하고 Hibernate 는 대조만 한다. 어긋나면 기동이 실패한다.
# 엔티티를 고쳤다면 마이그레이션 파일을 함께 추가한다.
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
JPA_SHOW_SQL=false


# ===== LLM (편지 피드백) =====
# 모델 ID 는 FEEDBACKS.model 에 기록돼 재현·과금 추적에 쓰인다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== MinIO (우표 이미지 저장소) =====
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=jollyadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=dear-jolly-stamps
# 기동 시 seed/stamps 이미지를 MinIO 에 올리고 STAMPS 행을 맞춘다. 이미 있으면 건너뛴다.
STAMP_SEED_ENABLED=true
# 클라이언트에 내려줄 우표 이미지 URL 기준. EC2 퍼블릭 주소로 채운다
# 앱이 내려주는 우표 이미지 URL 의 기준 주소. Caddy 가 버킷 경로를 MinIO 로 넘겨 HTTPS 로 제공한다.
# aws-setup.sh 가 https://{SITE_ADDRESS} 로 자동으로 채운다. 9000 을 직접 가리키지 않는다.
MINIO_PUBLIC_ENDPOINT=CHANGE_ME

# ============================================================
# 배포 설정 (GitHub Actions Secrets 로 등록되는 값)
# scripts/sync-prod-secrets.sh 가 이 파일을 읽어 Secrets 에 올린다.
# ============================================================

# ===== JWT =====
# openssl rand -base64 48 로 생성한 384비트 시크릿 (HS256 최소 요건 256비트)
JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRE=1800000   # 30분
JWT_REFRESH_EXPIRE=1209600000   # 14일

# ===== OAuth (발급 후 채운다. 비어 있어도 앱은 기동된다) =====
# 콘솔에서 [카카오 로그인 > 보안 > Client Secret] 을 '사용함' 으로 켰다면
# KAKAO_CLIENT_SECRET 은 필수다. 비워 두면 토큰 요청이 KOE010 으로 거절돼 로그인이 실패한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
OAUTH_APP_REDIRECT_URI=dearjolly://auth/callback

# ===== EC2 데이터 저장 경로 (호스트 바인드 마운트) =====
# 컨테이너가 아니라 EC2 호스트 디렉터리에 저장한다. 절대 경로만 쓴다 (~ 는 compose 가 해석하지 못한다)
MYSQL_DATA_PATH=/home/ubuntu/mount/mysql
MINIO_DATA_PATH=/home/ubuntu/mount/minio

# ===== 백업 =====
BACKUP_PATH=/home/ubuntu/backup   # 하위에 mysql/ minio/ 가 생성된다
BACKUP_RETENTION=3   # 보관 개수 (하루 1회 실행이므로 3일치)
BACKUP_SCHEDULE=30 3 * * *   # cron 표현식 (서버 TZ Asia/Seoul 기준, 매일 03:30)

# ===== AWS / ECR =====
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-northeast-2   # 서울 리전. 모든 리소스가 여기에 생성된다
ECR_REPOSITORY=dear-jolly-server

# ===== EC2 접속 =====
EC2_HOST=CHANGE_ME   # EC2 퍼블릭 IP 또는 도메인
EC2_USER=ubuntu                 # Ubuntu AMI: ubuntu / Amazon Linux: ec2-user
EC2_PORT=22                     # SSH 포트
EC2_SSH_KEY_PATH=~/.ssh/dear-jolly.pem   # 키페어(.pem) 로컬 경로. infra/infra.sh keypair 가 내려받는다
EC2_KEY_PAIR_NAME=dear-jolly             # CloudFormation 이 생성하는 EC2 키페어 이름
DEPLOY_PATH=/home/ubuntu/dear-jolly   # EC2 상의 배포 디렉터리

# ===== GitHub =====
# github-secrets.sh 가 Secrets 를 등록할 때 쓰는 토큰. gh CLI 로그인 대신 이 값을 쓴다.
# 필요한 권한: 해당 리포지터리의 Secrets 쓰기 (fine-grained PAT: Repository secrets - Read and write)
GH_TOKEN=CHANGE_ME

# ===== CloudFormation 스택 =====
STACK_ECR=dear-jolly-ecr
STACK_EC2=dear-jolly-ec2
EC2_INSTANCE_TYPE=t3.micro               # 1GB. 스왑으로 보완한다 (프리티어 대상)
EC2_SWAP_SIZE=4                          # 스왑 파일 크기(GB). 메모리가 작은 타입을 보완한다
EC2_VOLUME_SIZE=30                       # 루트 볼륨(GB). 이미지 2개 + DB 데이터 기준
ALLOWED_SSH_CIDR=0.0.0.0/0   # SSH 허용 대역. 가능하면 본인 IP/32 로 좁힐 것


# ===== 관리자 계정 (POST /api/v1/admin/login) =====
# 소셜 로그인과 무관한 별도 계정이다. 회원가입 API 는 없고 이 값이 유일한 자격 증명이라,
# 여기서 바꾸면 곧바로 운영 관리자 비밀번호가 바뀐다.
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# ===== 관리자 권한의 시드 User =====
# 관리자는 회원가입을 하지 않는다. 이 시드가 만든 계정이 있어야 위 ADMIN_USERNAME / ADMIN_PASSWORD 로
# 로그인할 수 있으므로 켜 둔다. 관리자 계정과 함께 샘플 편지 몇 통이 그 계정에 들어간다.
USER_SEED_ENABLED=true

# ===== .env.local 기준 추가 설정 =====
TERMS_CURRENT_VERSION=1.0.0
WITHDRAWAL_RETENTION_DAYS=30
