# 이 파일은 커밋된다. 실제 비밀값은 절대 넣지 말 것.
# 복사해서 .env 를 만들고, CHANGE_ME 자리를 각자 값으로 채운다.
#   cp .env.example .env

# ===== 애플리케이션 =====
# Caddy 가 여는 HTTPS 포트. 브라우저·앱은 https://localhost:8080 으로 접속한다
APP_PORT=8080
# HTTP 진입 포트. 여기로 들어오면 HTTPS 로 리다이렉트된다
# 80 이 다른 프로세스에 점유돼 있으면 8000 등으로 바꾼다
APP_HTTP_PORT=80
# 앱 컨테이너가 듣는 포트 (Caddy 뒤. 루프백으로만 열려 디버깅용으로 직접 접근 가능)
APP_INTERNAL_PORT=8081

# ===== MySQL =====
MYSQL_PORT=3306
MYSQL_DATABASE=dearjolly
MYSQL_USER=jolly
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ===== 데이터 저장 경로 (호스트 바인드 마운트) =====
# compose 파일(infra/docker) 기준 상대경로. 프로젝트 루트인 dear-jolly/mount/ 아래에 쌓인다.
# 컨테이너를 지워도 DB·이미지 데이터가 남는다.
MYSQL_DATA_PATH=../../../mount/mysql
MINIO_DATA_PATH=../../../mount/minio

# ===== JPA =====
# 스키마는 Flyway 가 소유하고 Hibernate 는 대조만 한다. 어긋나면 기동이 실패한다.
# 엔티티를 고쳤다면 마이그레이션 파일을 함께 추가한다.
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
JPA_SHOW_SQL=true

# ===== JWT =====
# HS256 시크릿. 256bit(32바이트) 이상이어야 한다.
JWT_SECRET=local-dev-jwt-secret-key-please-change-me-32bytes+
JWT_ACCESS_EXPIRE=1800000
JWT_REFRESH_EXPIRE=1209600000

# ===== 약관 / 탈퇴 =====
TERMS_CURRENT_VERSION=1.0.0
WITHDRAWAL_RETENTION_DAYS=30

# ===== 소셜 로그인 =====
# 인증을 마친 뒤 앱으로 돌아갈 딥링크
OAUTH_APP_REDIRECT_URI=dearjolly://auth/callback
# Kakao 개발자 콘솔 > 앱 키 > REST API 키
# 콘솔에서 [카카오 로그인 > 보안 > Client Secret] 을 '사용함' 으로 켰다면
# KAKAO_CLIENT_SECRET 은 필수다. 비워 두면 토큰 요청이 KOE010 으로 거절돼 로그인이 실패한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback
KAKAO_ADMIN_KEY=
# Apple Developer > Identifiers > Services ID
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/apple/callback


# ===== LLM (편지 피드백) =====
# 모델 ID 는 FEEDBACKS.model 에 기록돼 재현·과금 추적에 쓰인다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== MinIO (우표 이미지 저장소) =====
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=jollyadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=dear-jolly-stamps
# 앱이 내려주는 우표 이미지 URL 의 기준 주소. Caddy 가 버킷 경로를 MinIO 로 넘겨 HTTPS 로 제공한다.
# 9000 을 직접 가리키면 평문 HTTP 라 iOS ATS·Android cleartext 정책에 막힌다.
MINIO_PUBLIC_ENDPOINT=https://localhost:8080
# 기동 시 seed/stamps 이미지를 MinIO 에 올리고 STAMPS 행을 맞춘다. 이미 있으면 건너뛴다.
# 시드를 완전히 끄려면 false
STAMP_SEED_ENABLED=true

# ===== 관리자 계정 (POST /api/v1/admin/login) =====
# 소셜 로그인과 무관한 별도 계정이다. 회원가입 API 는 없고 이 값이 유일한 자격 증명이라,
# 여기서 바꾸면 곧바로 운영 관리자 비밀번호가 바뀐다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# ===== 관리자 권한의 시드 User =====
# 약관 동의·닉네임까지 끝난 ROLE_ADMIN 계정 하나를 넣는다. 편지는 시드하지 않는다.
# 관리자는 회원가입을 하지 않는다. 이 계정이 있어야 ADMIN_USERNAME / ADMIN_PASSWORD 로 로그인할 수 있고,
# 발급되는 토큰은 소셜 로그인 토큰과 똑같아서 편지·홈 API 까지 그대로 호출된다.
USER_SEED_ENABLED=true
USER_SEED_OAUTH_PROVIDER=KAKAO
USER_SEED_OAUTH_ID=seed-admin
USER_SEED_EMAIL=admin@dearjolly.local
# 닉네임은 영문·숫자 20자 이내여야 한다
USER_SEED_NICKNAME=jolly
