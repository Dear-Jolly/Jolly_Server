# 이 파일은 커밋된다. 실제 비밀값은 절대 넣지 말 것.
# 복사해서 .env 를 만들고, CHANGE_ME 자리를 각자 값으로 채운다.
#   cp .env.example .env

# ===== 애플리케이션 =====
# Caddy 가 여는 HTTPS 포트. 브라우저·앱은 https://localhost:8080 으로 접속한다
APP_PORT=8080
# HTTP 진입 포트. 여기로 들어오면 HTTPS 로 리다이렉트된다
# 80 이 다른 프로세스에 점유돼 있으면 8000 등으로 바꾼다
APP_HTTP_PORT=80
# 앱 컨테이너가 듣는 포트 (Caddy 뒤. 루프백으로만 열려 디버깅용으로 직접 접근 가능)
APP_INTERNAL_PORT=8081

# ===== MySQL =====
MYSQL_PORT=3306
MYSQL_DATABASE=dearjolly
MYSQL_USER=jolly
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ===== 데이터 저장 경로 (호스트 바인드 마운트) =====
# compose 파일(infra/docker) 기준 상대경로. 프로젝트 루트인 dear-jolly/mount/ 아래에 쌓인다.
# 컨테이너를 지워도 DB·이미지 데이터가 남는다.
MYSQL_DATA_PATH=../../../mount/mysql
MINIO_DATA_PATH=../../../mount/minio

# ===== JPA =====
# 스키마는 Flyway 가 소유한다. 전 환경 validate 고정 (기능명세 §4.3).
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true

# ===== JWT =====
# HS256 시크릿. 256bit(32바이트) 이상이어야 한다.
JWT_SECRET=local-dev-jwt-secret-key-please-change-me-32bytes+
JWT_ACCESS_EXPIRE=1800000
JWT_REFRESH_EXPIRE=1209600000

# ===== 약관 / 탈퇴 =====
TERMS_CURRENT_VERSION=1.0.0
WITHDRAWAL_RETENTION_DAYS=30

# ===== 소셜 로그인 =====
# 인증을 마친 뒤 앱으로 돌아갈 딥링크
OAUTH_APP_REDIRECT_URI=dearjolly://auth/callback
# Kakao 개발자 콘솔 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback
KAKAO_ADMIN_KEY=
# Apple Developer > Identifiers > Services ID
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/apple/callback

# ===== MinIO (우표 이미지 저장소) =====
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=jollyadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=dear-jolly-stamps
